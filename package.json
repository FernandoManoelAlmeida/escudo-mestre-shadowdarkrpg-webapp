{
  "name": "escudo-mestre-shadowdarkrpg-webapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "ulimit -n 10240 2>/dev/null || true; rm -f .next/dev/lock 2>/dev/null; next dev --webpack",
    "postinstall": "patch-package",
    "build": "next build --webpack && node scripts/write-version.js",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "yarn lint:fix && yarn prettier --write .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "icons:pwa": "node scripts/icons-from-shadowdark-spot-art.js",
    "migrate:regras-shadowdark": "node scripts/migrate-regras-shadowdark.js",
    "migrate:ameacas-shadowdark": "node scripts/migrate-ameacas-shadowdark.js",
    "migrate:tabelas-shadowdark": "node scripts/migrate-tabelas-shadowdark.js",
    "migrate:catalogo-itens-magicos-shadowdark": "node scripts/migrate-catalogo-itens-magicos-shadowdark.js",
    "migrate:catalogo-magias-shadowdark": "node scripts/migrate-catalogo-magias-shadowdark.js",
    "migrate:catalogo-classes-shadowdark": "node scripts/migrate-catalogo-classes-shadowdark.js",
    "migrate:catalogo-ancestralidades-shadowdark": "node scripts/migrate-catalogo-ancestralidades-shadowdark.js",
    "migrate:catalogo-antecedentes-shadowdark": "node scripts/migrate-catalogo-antecedentes-shadowdark.js",
    "migrate:regras-homebrew-shadowdark": "node scripts/migrate-regras-homebrew-shadowdark.js",
    "extract:classes-shadowdark": "node scripts/extract-classes-shadowdark.js",
    "extract:ancestralidades-shadowdark": "node scripts/extract-ancestralidades-shadowdark.js",
    "extract:antecedentes-shadowdark": "node scripts/extract-antecedentes-shadowdark.js",
    "extract:regras-homebrew-shadowdark": "node scripts/extract-regras-homebrew-shadowdark.js",
    "extract:magias-shadowdark": "node scripts/extract-magias-from-vault.js",
    "migrate:from-fantasia": "node scripts/migrate-from-fantasia.js",
    "validate:data": "node scripts/validate-migrated-data.js --strict",
    "build:android:twa:init": "node scripts/init-twa.js",
    "build:android:twa": "cd android-twa && npx @bubblewrap/cli build",
    "build:capacitor": "cross-env BUILD_ANDROID_CAPACITOR=1 next build --webpack",
    "build:android:capacitor:init": "yarn build:capacitor && npx cap init \"Escudo Mestre\" \"com.escudo.mestre\" --web-dir=out && npx cap add android",
    "build:android:capacitor": "yarn build:capacitor && npx cap sync android && npx cap build android -- --release"
  },
  "dependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "next": "16.1.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "styled-components": "^6.3.11"
  },
  "devDependencies": {
    "@capacitor/android": "^8.2.0",
    "@capacitor/cli": "^7.6.0",
    "@capacitor/core": "^8.2.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/styled-components": "^5.1.36",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.0",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.7",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.0.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.8.1",
    "sharp": "^0.34.5",
    "typescript": "^5",
    "vitest": "^4.1.0"
  }
}
